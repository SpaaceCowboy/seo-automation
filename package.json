{
  "name": "roco-seo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm build:packages && pnpm --filter @roco/api --filter @roco/worker --filter @roco/dashboard build",
    "build:packages": "pnpm --filter @roco/config build && pnpm --filter @roco/shared build && pnpm --filter @roco/db build && pnpm --filter @roco/testkit build",
    "dev": "pnpm --parallel --filter @roco/api --filter @roco/worker --filter @roco/dashboard dev",
    "dev:api": "pnpm --filter @roco/api dev",
    "dev:worker": "pnpm --filter @roco/worker dev",
    "dev:dashboard": "pnpm --filter @roco/dashboard dev",
    "db:generate": "pnpm --filter @roco/db db:generate",
    "db:migrate": "pnpm --filter @roco/db db:migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm build:packages && vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "pnpm build:packages && vitest run packages/db/test/migrations.integration.test.ts",
    "test:all": "pnpm test && pnpm test:integration",
    "typecheck": "pnpm build:packages && pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  }
}
