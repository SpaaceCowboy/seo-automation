# Runtime
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL used by the API, worker, Drizzle, and pg-boss.
DATABASE_URL=postgresql://roco_seo:roco_seo_dev@127.0.0.1:5432/roco_seo

# Local-only service bindings. Do not expose the dashboard publicly before
# authentication is selected and implemented.
API_HOST=127.0.0.1
API_PORT=4000
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000

# Worker lifecycle
WORKER_HEALTH_JOB_ENABLED=true
WORKER_HEALTH_JOB_SCHEDULE=*/5 * * * *
WORKER_SHUTDOWN_TIMEOUT_MS=10000

# Conservative Phase 2 crawler defaults. Production origin/host policy is
# stored per site; private-network targets remain blocked by application code.
CRAWLER_USER_AGENT=RocoSEO/1.0 (+https://rocobroker.com/; technical SEO audit)
CRAWLER_MAX_PAGES=30
CRAWLER_MAX_DEPTH=6
CRAWLER_CONCURRENCY=1
CRAWLER_REQUESTS_PER_SECOND=1
CRAWLER_REQUEST_TIMEOUT_MS=15000
CRAWLER_MAX_RESPONSE_BYTES=2000000
CRAWLER_MAX_REDIRECTS=5
CRAWLER_RETRY_LIMIT=2

# Phase 3 Google integrations. GOOGLE_CREDENTIALS_FILE points to a local or
# mounted service-account JSON file; never paste credential JSON into this file.
GOOGLE_CREDENTIALS_FILE=
GOOGLE_SITE_ID=
GSC_PROPERTY=
GA4_PROPERTY_ID=
PAGESPEED_API_KEY=
GOOGLE_BACKFILL_DAYS=90
GOOGLE_REQUEST_TIMEOUT_MS=30000
GOOGLE_RETRY_LIMIT=3
GOOGLE_REQUESTS_PER_SECOND=2
GOOGLE_SCHEDULES_ENABLED=false
GSC_SYNC_SCHEDULE=15 4 * * *
GA4_SYNC_SCHEDULE=45 4 * * *
PAGESPEED_SYNC_SCHEDULE=15 5 * * 1
PAGESPEED_REFRESH_HOURS=168
