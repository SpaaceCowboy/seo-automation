# Runtime
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL used by the API, worker, Drizzle, and pg-boss.
DATABASE_URL=postgresql://roco_seo:roco_seo_dev@127.0.0.1:5432/roco_seo

# Local-only service bindings. Do not expose the dashboard publicly before
# authentication is selected and implemented.
API_HOST=127.0.0.1
API_PORT=4000
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000

# Worker lifecycle
WORKER_HEALTH_JOB_ENABLED=true
WORKER_HEALTH_JOB_SCHEDULE=*/5 * * * *
WORKER_SHUTDOWN_TIMEOUT_MS=10000

# Conservative Phase 2 crawler defaults. Production origin/host policy is
# stored per site; private-network targets remain blocked by application code.
CRAWLER_USER_AGENT=RocoSEO/1.0 (+https://rocobroker.com/; technical SEO audit)
CRAWLER_MAX_PAGES=30
CRAWLER_MAX_DEPTH=6
CRAWLER_CONCURRENCY=1
CRAWLER_REQUESTS_PER_SECOND=1
CRAWLER_REQUEST_TIMEOUT_MS=15000
CRAWLER_MAX_RESPONSE_BYTES=2000000
CRAWLER_MAX_REDIRECTS=5
CRAWLER_RETRY_LIMIT=2

# Phase 3 Google integrations. GOOGLE_CREDENTIALS_FILE points to a local or
# mounted service-account JSON file; never paste credential JSON into this file.
GOOGLE_CREDENTIALS_FILE=
GOOGLE_SITE_ID=
GSC_PROPERTY=
GA4_PROPERTY_ID=
PAGESPEED_API_KEY=
GOOGLE_BACKFILL_DAYS=90
GOOGLE_REQUEST_TIMEOUT_MS=30000
GOOGLE_RETRY_LIMIT=3
GOOGLE_REQUESTS_PER_SECOND=2
GOOGLE_SCHEDULES_ENABLED=false
GOOGLE_FINALITY_DAYS=3
GSC_SYNC_SCHEDULE=15 4 * * *
GA4_SYNC_SCHEDULE=45 4 * * *
PAGESPEED_SYNC_SCHEDULE=15 5 * * 1
PAGESPEED_REFRESH_HOURS=168

# Phase 4 bearer credential; unset disables all opportunity endpoints. Generate at least 32 random characters.
# OPPORTUNITY_API_TOKEN=<private-operator-token>
# Optional active actors.id attributed to acknowledgement/dismissal/reopen operations.
# OPPORTUNITY_ACTOR_ID=<registered-operator-uuid>

# Phase 5: disabled until provider, models, pricing and data-processing scope are approved.
AGENTS_ENABLED=false
# AGENT_API_TOKEN=<private-analysis-operator-token-at-least-32-characters>
# AGENT_ACTOR_ID=<active-registered-actor-uuid>
# Worker-only credential. Ambient OPENAI_API_KEY is not consumed automatically.
# LLM_OPENAI_API_KEY=<openai-project-key>
# Complete JSON route/pricing/limit policy; never include credentials here.
# LLM_POLICY_JSON=<validated-agent-policy-json>

# Phase 6 named actor/role credentials. Keep actual JSON tokens in secret injection.
# WORKFLOW_ACCESS_JSON=<array-of-token-actorId-roles-entries>
# Data-only measurement dispatch; no website writes.
WORKFLOW_SCHEDULES_ENABLED=false
# WORKFLOW_MEASUREMENT_ACTOR_ID=<active-service-actor-uuid>
WORKFLOW_MEASUREMENT_SCHEDULE=15 * * * *

# Phase 7 private dashboard (server-only; do not use NEXT_PUBLIC_ prefixes).
# Named sign-in credentials/roles still come from the API's WORKFLOW_ACCESS_JSON.
# Exact browser origin. Use HTTPS for any remote deployment.
DASHBOARD_ORIGIN=http://127.0.0.1:3000
# Fixed internal Fastify origin; keep Fastify off the public reverse proxy.
DASHBOARD_API_URL=http://127.0.0.1:4000

# Production mounted-secret alternatives (choose a value OR its _FILE, never both).
# DATABASE_URL_FILE=/run/secrets/database_url
# WORKFLOW_ACCESS_JSON_FILE=/run/secrets/workflow_access
# OPPORTUNITY_API_TOKEN_FILE=/run/secrets/opportunity_token
# AGENT_API_TOKEN_FILE=/run/secrets/agent_token
# LLM_OPENAI_API_KEY_FILE=/run/secrets/llm_openai_key
# PAGESPEED_API_KEY_FILE=/run/secrets/pagespeed_key
WORKER_HEALTH_FILE=/tmp/roco-worker-health.json
