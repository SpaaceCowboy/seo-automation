# Non-secret Compose variables. Actual copy: /opt/roco-seo/config/compose.env
ROCO_APP_IMAGE=roco-seo:phase75
ROCO_ENV_FILE=/opt/roco-seo/config/production.env
ROCO_SECRETS_DIR=/opt/roco-seo/secrets
ROCO_OPERATIONS_DIR=/opt/roco-seo/operations
ROCO_PROXY_PORT=8087
# SSH tunnel: ssh -L 8087:127.0.0.1:8087 root@<vps>
DASHBOARD_ORIGIN=http://127.0.0.1:8087

# For the approved HTTPS hostname, issue its certificate first, then enable
# /opt/roco-seo/config/https.enabled and use the exact origin below.
# DASHBOARD_ORIGIN=https://scc.rocobroker.com
# ROCO_TLS_DIR=/etc/letsencrypt
# ROCO_ACME_DIR=/var/lib/roco-acme
