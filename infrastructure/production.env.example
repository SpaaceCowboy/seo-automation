# Non-secret application configuration. Actual copy: /opt/roco-seo/config/production.env
LOG_LEVEL=info
CRAWLER_MAX_PAGES=500
CRAWLER_CONCURRENCY=1
CRAWLER_REQUESTS_PER_SECOND=0.5
CRAWLER_MAX_DEPTH=10
GOOGLE_FINALITY_DAYS=3
GOOGLE_SCHEDULES_ENABLED=false
# GOOGLE_SITE_ID=<registered site UUID>
# GOOGLE_CREDENTIALS_FILE=/run/google/service-account.json
# GSC_PROPERTY=sc-domain:rocobroker.com
# GA4_PROPERTY_ID=<numeric property ID>
# PAGESPEED_API_KEY must be supplied as a separate worker-only secret, not here.
AGENTS_ENABLED=false
# LLM_POLICY_JSON=<reviewed model routes, integer prices and budget caps; no key>
# AGENT_ACTOR_ID=<active HUMAN actor UUID>
# OPPORTUNITY_ACTOR_ID=<active HUMAN actor UUID>
WORKFLOW_SCHEDULES_ENABLED=false
# WORKFLOW_MEASUREMENT_ACTOR_ID=<active SERVICE actor UUID>
