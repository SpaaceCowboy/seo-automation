# Runtime
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL used by the API, worker, Drizzle, and pg-boss.
DATABASE_URL=postgresql://roco_seo:roco_seo_dev@127.0.0.1:5432/roco_seo

# Local-only service bindings. Do not expose the dashboard publicly before
# authentication is selected and implemented.
API_HOST=127.0.0.1
API_PORT=4000
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000

# Worker lifecycle
WORKER_HEALTH_JOB_ENABLED=true
WORKER_HEALTH_JOB_SCHEDULE=*/5 * * * *
WORKER_SHUTDOWN_TIMEOUT_MS=10000
