{
  "name": "@roco/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "import": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx src/migrate.ts",
    "site:upsert": "tsx src/seed-site.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@roco/config": "workspace:*",
    "@roco/integrations": "workspace:*",
    "@roco/seo-core": "workspace:*",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.0",
    "@roco/opportunities": "workspace:*",
    "@roco/agents": "workspace:*",
    "@roco/workflow": "workspace:*",
    "@roco/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
